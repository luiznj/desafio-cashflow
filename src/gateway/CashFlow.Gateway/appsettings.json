{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Jwt": {
    "Authority": "http://localhost:5001",
    "Audience": "cashflow-services"
  },
  "ReverseProxy": {
    "Routes": {
      "identity-auth-route": {
        "ClusterId": "identity-cluster",
        "Match": { "Path": "/api/v1/auth/{**catch-all}" }
      },
      "identity-jwks-route": {
        "ClusterId": "identity-cluster",
        "Match": { "Path": "/.well-known/{**catch-all}" }
      },
      "transaction-route": {
        "ClusterId": "transaction-cluster",
        "Match": { "Path": "/api/v1/transactions/{**catch-all}" },
        "AuthorizationPolicy": "authenticated"
      },
      "consolidation-route": {
        "ClusterId": "consolidation-cluster",
        "Match": { "Path": "/api/v1/balances/{**catch-all}" },
        "AuthorizationPolicy": "authenticated"
      }
    },
    "Clusters": {
      "identity-cluster": {
        "Destinations": {
          "default": { "Address": "http://localhost:5001" }
        }
      },
      "transaction-cluster": {
        "Destinations": {
          "default": { "Address": "http://localhost:5002" }
        }
      },
      "consolidation-cluster": {
        "Destinations": {
          "default": { "Address": "http://localhost:5003" }
        }
      }
    }
  }
}
