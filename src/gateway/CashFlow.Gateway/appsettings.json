{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ReverseProxy": {
    "Routes": {
      "identity-route": {
        "ClusterId": "identity-cluster",
        "Match": { "Path": "/identity/{**catch-all}" },
        "Transforms": [{ "PathRemovePrefix": "/identity" }]
      },
      "transaction-route": {
        "ClusterId": "transaction-cluster",
        "Match": { "Path": "/transactions/{**catch-all}" },
        "Transforms": [{ "PathRemovePrefix": "/transactions" }]
      },
      "consolidation-route": {
        "ClusterId": "consolidation-cluster",
        "Match": { "Path": "/consolidation/{**catch-all}" },
        "Transforms": [{ "PathRemovePrefix": "/consolidation" }]
      }
    },
    "Clusters": {
      "identity-cluster": {
        "Destinations": {
          "default": { "Address": "http://localhost:5001" }
        }
      },
      "transaction-cluster": {
        "Destinations": {
          "default": { "Address": "http://localhost:5002" }
        }
      },
      "consolidation-cluster": {
        "Destinations": {
          "default": { "Address": "http://localhost:5003" }
        }
      }
    }
  }
}
